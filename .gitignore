.dev.vars
.dev.vars.*
# wrangler のビルド/キャッシュ成果物
.wrangler/
dist/

# --- 環境変数ファイル ---
.env
.env.*

# --- ログ ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS / エディタ ---
.DS_Store
Thumbs.db
*.swp
.vscode/

# 注: docs/config.js は公開してよい値のみ（Public Key / URL Endpoint / Worker URL）なので
